/* Pad: graphite surfaces, 4px spacing grid, bundled Geist. Qt 5/6. */
QWidget { color: #e8e8eb; font-family: "Geist"; font-size: 13px; }
QMainWindow, QDialog { background: #111113; }
QWidget#centralWidget, QWidget#padWorkspace { background: #111113; }
QFrame#padSidebar { background: #171719; border-right: 1px solid #29292d; }
QLabel#padBrand { font-size: 20px; font-weight: 600; color: #fafafa; }
QLabel#padTitle { font-size: 22px; font-weight: 600; }
QLabel#padSubtitle, QLabel[padMuted="true"] { color: #929298; }
QLabel#padSection { color: #929298; font-size: 11px; }
QLabel#padEmpty { color: #929298; font-size: 15px; }
QFrame#padHeader { border-bottom: 1px solid #29292d; background: #111113; }
QFrame#padOverview { background: #19191c; border: 1px solid #2b2b30; border-radius: 10px; }
QLabel#padDeviceName { font-size: 16px; font-weight: 600; }
QPushButton, QToolButton { background: #242428; border: 1px solid #38383e; border-radius: 6px; padding: 6px 12px; min-height: 20px; }
QPushButton:hover, QToolButton:hover { background: #303035; border-color: #505058; }
QPushButton:pressed, QToolButton:pressed { background: #39393f; }
QPushButton:focus, QToolButton:focus { border-color: #96969e; }
QPushButton:disabled, QToolButton:disabled { color: #67676f; background: #1b1b1e; border-color: #29292f; }
QPushButton#saveButton, QPushButton[padPrimary="true"] { background: #eeeeef; color: #171719; border-color: #eeeeef; font-weight: 600; }
QPushButton#saveButton:hover, QPushButton[padPrimary="true"]:hover { background: #ffffff; }
QPushButton[padNav="true"] { text-align: left; background: transparent; border: none; padding: 7px 12px; }
QPushButton[padNav="true"]:hover { background: #242428; }
QPushButton[padNav="true"]:checked { background: #2b2b30; color: #ffffff; }
QPushButton[setActive="true"], QPushButton#namesPushButton[isDisplayingNames="true"] { background: #eeeeef; color: #171719; border-color: #eeeeef; }
QPushButton[setActive="false"] { background: #1b1b1e; color: #929298; }
FlashButtonWidget[isflashing="true"], QPushButton[isflashing="true"] { background: #e8e8eb; color: #111113; border-color: #ffffff; }
QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit { background: #19191c; border: 1px solid #38383e; border-radius: 6px; padding: 6px 10px; min-height: 20px; selection-background-color: #484850; selection-color: #ffffff; }
QLineEdit:focus, QComboBox:focus, QTextEdit:focus { border-color: #96969e; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow { image: url(:/pad/icons/chevron-down.svg); width: 14px; height: 14px; }
QComboBox QAbstractItemView { background: #202024; border: 1px solid #38383e; selection-background-color: #39393f; padding: 4px; }
QAbstractItemView { background: #171719; border: 1px solid #29292d; border-radius: 6px; selection-background-color: #303035; selection-color: #ffffff; alternate-background-color: #1c1c20; outline: none; }
QListWidget#padControllers { background: transparent; border: none; }
QListWidget#padControllers::item { min-height: 34px; border-radius: 6px; padding: 3px 10px; margin: 2px 0; }
QListWidget#padControllers::item:selected { background: #2b2b30; }
QListWidget#padControllers::item:hover { background: #242428; }
QHeaderView::section { background: #202024; border: none; border-bottom: 1px solid #38383e; padding: 8px; }
QScrollArea, QStackedWidget { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: #111113; }
QTabWidget::pane { border: none; }
QTabBar::tab { color: #929298; background: transparent; padding: 9px 14px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #eeeeef; border-bottom: 2px solid #eeeeef; }
QTabBar::tab:hover { color: #eeeeef; background: #202024; }
QGroupBox { border: 1px solid #303035; border-radius: 8px; margin-top: 14px; padding: 14px 10px 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; }
QMenuBar { background: #171719; border-bottom: 1px solid #29292d; padding: 3px; }
QMenuBar::item { padding: 5px 9px; background: transparent; }
QMenuBar::item:selected { background: #303035; border-radius: 4px; }
QMenu { background: #202024; border: 1px solid #38383e; padding: 5px; }
QMenu::item { padding: 7px 24px; border-radius: 4px; }
QMenu::item:selected { background: #39393f; }
QMenu::separator { height: 1px; background: #38383e; margin: 4px 8px; }
QStatusBar { color: #929298; background: #171719; border-top: 1px solid #29292d; }
QStatusBar::item { border: none; }
QToolTip { color: #eeeeef; background: #303035; border: 1px solid #484850; padding: 6px; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #3c3c43; border-radius: 3px; min-height: 24px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #3c3c43; border-radius: 3px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QCheckBox, QRadioButton { spacing: 8px; }
QCheckBox::indicator { width: 15px; height: 15px; border: 1px solid #505058; border-radius: 4px; background: #19191c; }
QCheckBox::indicator:checked { background: #eeeeef; image: url(:/pad/icons/check-dark.svg); }
QRadioButton::indicator { width: 15px; height: 15px; border: 1px solid #505058; border-radius: 8px; background: #19191c; }
QRadioButton::indicator:checked { background: #eeeeef; border: 4px solid #505058; }
QSlider::groove:horizontal { height: 4px; background: #38383e; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -4px 0; background: #eeeeef; border-radius: 6px; }
QProgressBar { background: #242428; border: none; border-radius: 4px; text-align: center; }
QProgressBar::chunk { background: #929298; border-radius: 4px; }

QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 22px; border: none; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 22px; border: none; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/pad/icons/chevron-up.svg); width: 12px; height: 12px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/pad/icons/chevron-down.svg); width: 12px; height: 12px; }
QSpinBox, QDoubleSpinBox { padding-right: 24px; }
