<?xml version="1.0" encoding="utf-8"?>
<component type="desktop-application">
  <id>io.github.davaughnl.Pad</id>
  <name>Pad</name>
  <summary>Map controller buttons and sticks to keyboard and mouse controls</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description><p>Pad is a redesigned AntiMicroX fork. Map controllers to keyboard and mouse controls while Pad runs in the background.</p><p>Existing AntiMicroX profiles, macros and mapping sets are supported. Input compatibility depends on OS permissions and application restrictions.</p></description>
  <launchable type="desktop-id">io.github.davaughnl.Pad.desktop</launchable>
  <url type="homepage">https://github.com/davaughnl/Pad</url>
  <url type="bugtracker">https://github.com/davaughnl/Pad/issues</url>
  <provides><binary>pad</binary></provides>
</component>
